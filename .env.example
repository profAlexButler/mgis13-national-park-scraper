# NPS API Key
# Get your free API key from: https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=your_nps_api_key_here

# Google Sheets Credentials
# Path to your Google Cloud service account credentials JSON file
GOOGLE_SHEETS_CREDENTIALS=/path/to/your/credentials.json

# Instructions:
# 1. Copy this file to .env (do not commit .env!)
# 2. Replace the placeholder values with your actual credentials
# 3. To load these variables, run: source .env
#    Or use: export $(cat .env | xargs)
